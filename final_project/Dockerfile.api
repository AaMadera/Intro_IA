FROM python:3.12-slim

WORKDIR /app

COPY pyproject.toml uv.lock ./
RUN pip install --no-cache-dir uv \
    && uv sync --locked --no-dev

COPY app ./app
COPY pdfs_seed ./pdfs_seed
COPY data ./data

# opendataloader-pdf is optional; app.extract falls back to pypdf when it is absent or fails.
EXPOSE 8000

FROM python:3.12-slim

WORKDIR /app

RUN apt-get update \
    && apt-get install -y --no-install-recommends openjdk-21-jre-headless curl \
    && rm -rf /var/lib/apt/lists/*

COPY pyproject.toml uv.lock ./
RUN pip install --no-cache-dir uv \
    && uv sync --locked --no-dev \
    && uv pip install --python .venv/bin/python opendataloader-pdf

COPY app ./app
COPY pdfs_seed ./pdfs_seed
COPY data ./data

# pypdf remains the fallback when OpenDataLoader cannot extract a document.
EXPOSE 8000
